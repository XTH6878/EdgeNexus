{
  "Urls": "http://127.0.0.1:5088",
  "Gateway": {
    "DataDirectory": "data"
  },
  "Authentication": {
    "AdminUsername": "admin",
    "AdminPassword": "123456",
    "MaximumFailedAttempts": 5,
    "LockoutMinutes": 15,
    "RequireHttps": false
  },
  "AcquisitionStability": {
    "FailureThreshold": 3,
    "SuccessThreshold": 2,
    "HeartbeatIntervalSeconds": 10,
    "ReconnectDelaysSeconds": [ 1, 2, 5, 10, 30 ],
    "ReconnectJitterRatio": 0.2
  },
  "Swagger": {
    "Enabled": true
  },
  "AllowedHosts": "*"
}
